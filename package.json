{
  "name": "huncho",
  "version": "0.1.0",
  "description": "Huncho — your personal hands-free AI assistant that drives the browser by voice",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:panel\" \"npm run dev:overlay\" \"npm run dev:urlbar\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:panel": "vite --config vite.config.panel.ts",
    "dev:overlay": "vite --config vite.config.overlay.ts",
    "dev:urlbar": "vite --config vite.config.urlbar.ts",
    "build": "npm run build:main && npm run build:panel && npm run build:overlay && npm run build:urlbar",
    "build:main": "tsc -p tsconfig.main.json",
    "build:panel": "vite build --config vite.config.panel.ts",
    "build:overlay": "vite build --config vite.config.overlay.ts",
    "build:urlbar": "vite build --config vite.config.urlbar.ts",
    "dist": "npm run build && electron-builder",
    "start": "electron .",
    "start:dev": "cross-env NODE_ENV=development electron .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.0",
    "cross-env": "^10.1.0",
    "electron": "^32.0.0",
    "electron-builder": "^24.13.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "msedge-tts": "^2.0.4",
    "onnxruntime-node": "^1.27.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "uiohook-napi": "^1.5.3",
    "ws": "^8.18.0"
  },
  "build": {
    "appId": "com.huncho.app",
    "productName": "Huncho",
    "copyright": "Copyright © 2026 Huncho",
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "artifactName": "Huncho-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Huncho"
    }
  }
}
